[Desktop Entry]
Name=TDP Manager
Comment=Intel CPU Power Limit Manager
GenericName=Power Manager
Exec=sh -c "$HOME/predator_power_linux/dist/predator-power tui"
Icon=preferences-system-power
Terminal=true
Type=Application
Categories=System;Settings;HardwareSettings;
Keywords=tdp;power;cpu;intel;throttle;performance;
StartupNotify=true
